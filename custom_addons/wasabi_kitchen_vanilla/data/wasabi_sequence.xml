<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- Sequence untuk Order: ORD/YYYY/MM/NNNN -->
    <record id="seq_wasabi_order" model="ir.sequence">
        <field name="name">Wasabi Order</field>
        <field name="code">wasabi.order</field>
        <field name="prefix">ORD/%(year)s/%(month)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence untuk Menu Item: MN-NNNN -->
    <record id="seq_wasabi_menu_item" model="ir.sequence">
        <field name="name">Wasabi Menu Item</field>
        <field name="code">wasabi.menu.item</field>
        <field name="prefix">MN-</field>
        <field name="padding">3</field>
        <field name="number_increment">1</field>
        <field name="use_date_range" eval="False"/>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence untuk Transaksi: TRX/YYYY/MM/NNNN -->
    <record id="seq_wasabi_transaction" model="ir.sequence">
        <field name="name">Wasabi Transaction</field>
        <field name="code">wasabi.transaction</field>
        <field name="prefix">TRX/%(year)s/%(month)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
