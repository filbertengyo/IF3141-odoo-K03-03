<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================
         Module Category
         ===================================================== -->
    <record id="module_category_wasabi" model="ir.module.category">
        <field name="name">Wasabi Kitchen</field>
        <field name="description">Akses Sistem QR-Ordering &amp; KDS Wasabi Kitchen</field>
        <field name="sequence">25</field>
    </record>

    <!-- =====================================================
         Groups (Roles) — flat, no implied_ids
         koki   : Kitchen Display app only
         kasir  : Kasir app only
         manager: Pelaporan app only (query + export transaksi)
         admin  : Wasabi Kitchen app (full access, all dropdowns)
         ===================================================== -->
    <record id="group_wasabi_koki" model="res.groups">
        <field name="name">Koki</field>
        <field name="category_id" ref="module_category_wasabi"/>
    </record>

    <record id="group_wasabi_kasir" model="res.groups">
        <field name="name">Kasir</field>
        <field name="category_id" ref="module_category_wasabi"/>
    </record>

    <record id="group_wasabi_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_wasabi"/>
    </record>

    <record id="group_wasabi_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="module_category_wasabi"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- =====================================================
         Record Rules
         ===================================================== -->

    <!-- Kasir hanya lihat transaksi milik sendiri -->
    <record id="rule_transaction_kasir_own" model="ir.rule">
        <field name="name">Kasir: hanya transaksi sendiri</field>
        <field name="model_id" ref="model_wasabi_transaction"/>
        <field name="domain_force">[('staff_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_wasabi_kasir'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Manager dan Admin lihat semua transaksi -->
    <record id="rule_transaction_manager_all" model="ir.rule">
        <field name="name">Manager: semua transaksi</field>
        <field name="model_id" ref="model_wasabi_transaction"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_wasabi_manager'))]"/>
    </record>

    <record id="rule_transaction_admin_all" model="ir.rule">
        <field name="name">Admin: semua transaksi</field>
        <field name="model_id" ref="model_wasabi_transaction"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_wasabi_admin'))]"/>
    </record>

</odoo>
