<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================
         CATEGORY — Tree
         ===================================================== -->
    <record id="view_wasabi_category_tree" model="ir.ui.view">
        <field name="name">wasabi.category.tree</field>
        <field name="model">wasabi.category</field>
        <field name="arch" type="xml">
            <tree string="Kategori Menu" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="menu_item_count" string="Jumlah Menu"/>
                <field name="is_active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- =====================================================
         CATEGORY — Kanban (landing page untuk Menu & Stok)
         ===================================================== -->
    <record id="view_wasabi_category_kanban" model="ir.ui.view">
        <field name="name">wasabi.category.kanban</field>
        <field name="model">wasabi.category</field>
        <field name="arch" type="xml">
            <kanban class="o_wasabi_category_kanban o_wasabi_cat_hub"
                    create="false" group_create="false" sample="1">
                <field name="id"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="menu_item_count"/>
                <field name="is_active"/>
                <field name="color"/>
                <field name="description"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_wasabi_cat_hub_card">
                            <button name="action_view_menu_items" type="object"
                                    class="o_wasabi_cat_hub_btn">
                                <div class="o_wasabi_cat_hub_icon">
                                    <span><t t-esc="record.icon.raw_value or '🍽️'"/></span>
                                </div>
                                <div class="o_wasabi_cat_hub_label">
                                    <strong><t t-esc="record.name.raw_value"/></strong>
                                    <small>
                                        <t t-if="record.menu_item_count.raw_value > 0">
                                            <t t-esc="record.menu_item_count.raw_value"/> item
                                        </t>
                                        <t t-else="">Semua menu</t>
                                    </small>
                                </div>
                                <span class="o_wasabi_cat_hub_arrow">→</span>
                            </button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- =====================================================
         CATEGORY — Form
         ===================================================== -->
    <record id="view_wasabi_category_form" model="ir.ui.view">
        <field name="name">wasabi.category.form</field>
        <field name="model">wasabi.category</field>
        <field name="arch" type="xml">
            <form string="Kategori Menu">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_menu_items" type="object"
                                class="oe_stat_button" icon="fa-cutlery">
                            <field name="menu_item_count" widget="statinfo" string="Menu"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Nonaktif" bg_color="text-bg-danger"
                            invisible="is_active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Nama Kategori, mis. Sushi"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="icon" placeholder="🍣"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <separator string="Deskripsi"/>
                    <field name="description" placeholder="Deskripsi singkat kategori..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- =====================================================
         CATEGORY — Action
         ===================================================== -->
    <record id="action_wasabi_category" model="ir.actions.act_window">
        <field name="name">Menu &amp; Stok</field>
        <field name="res_model">wasabi.category</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_wasabi_category_kanban')}),
            (0, 0, {'view_mode': 'tree',   'view_id': ref('view_wasabi_category_tree')}),
            (0, 0, {'view_mode': 'form',   'view_id': ref('view_wasabi_category_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada kategori menu</p>
            <p>Buat kategori untuk mengelompokkan menu (Sushi, Ramen, Bento, dll).</p>
        </field>
    </record>

</odoo>
